# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env

# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 화면 상단에 표시할 프로젝트 이름
PROJECT_NAME=콜드체인 프로젝트

# 사용할 모델과 생각 깊이(low | medium | high | xhigh | max). 높을수록 정확하지만 느리고 비쌉니다.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=high

# 서버 주소. 같은 네트워크의 팀원이 접속하게 하려면 HOST=0.0.0.0
HOST=127.0.0.1
PORT=3000

# 팀에 공유할 때 접속 비밀번호(브라우저가 물어보면 아이디는 아무거나, 비밀번호는 이 값)
APP_PASSWORD=

# 업로드 자료와 대화가 저장되는 폴더, 파일당 최대 크기(MB)
DATA_DIR=data
MAX_UPLOAD_MB=50
